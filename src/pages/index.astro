---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import IconRss from "@/assets/icons/IconRss.svg";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import Card from "@/components/Card.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import LinkButton from "@/components/LinkButton.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, filterByCategory } from "@/utils/categories";
import { useTranslations } from "@/i18n";
import config from "@/config";

const { socials } = config;

const locale = Astro.currentLocale ?? config.site.lang;
const t = useTranslations(locale);

const sortedPosts = getSortedPosts(await getCollection("posts"));

// 项目：优先展示 featured，最多 3 个
const projects = filterByCategory(sortedPosts, "project");
const featuredProjects = [
  ...projects.filter(p => p.data.featured),
  ...projects.filter(p => !p.data.featured),
].slice(0, 3);

const leetcodePosts = filterByCategory(sortedPosts, "leetcode").slice(0, 3);
const thoughtPosts = filterByCategory(sortedPosts, "thought").slice(0, 3);

const sections = [
  { key: "leetcode", posts: leetcodePosts },
  { key: "thought", posts: thoughtPosts },
] as const;

const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="app-layout my-1"
  >
    <section id="hero" class="border-border border-b pt-8 pb-6">
      <h1 class="my-4 inline-block text-4xl font-bold sm:my-8 sm:text-5xl">
        你好，我是龚晨昊
      </h1>{" "}
      <a
        target="_blank"
        href={`${import.meta.env.BASE_URL.replace(/\/?$/, "/")}rss.xml`}
        class="inline-block"
        aria-label="RSS 订阅"
        title="RSS 订阅"
      >
        <IconRss
          width={20}
          height={20}
          class="stroke-accent scale-125 stroke-3 rtl:-rotate-90"
        />
        <span class="sr-only">RSS 订阅</span>
      </a>

      <p>
        江南大学人工智能硕士在读，关注 Agent 与 AI
        Infra。这里记录我做过的项目、刷题时的思考，以及一些关于技术和学习的想法。
      </p>
      <p class="mt-2">
        想快速了解我？看看我的
        <LinkButton
          class="hover:text-accent underline decoration-dashed underline-offset-4"
          href={config.site.profile ?? "#"}
        >
          在线简历
        </LinkButton>
        。
      </p>
      {
        socials.length > 0 && (
          <div class="mt-4 flex max-sm:flex-col sm:items-center">
            <div class="me-2 mb-1 whitespace-nowrap sm:mb-0">
              {t.home.socialLinks}：
            </div>
            <Socials />
          </div>
        )
      }
    </section>

    {
      featuredProjects.length > 0 && (
        <section id="projects" class="border-border border-b pt-12 pb-6">
          <h2 class="text-2xl font-semibold tracking-wide">精选项目</h2>
          <ul>
            {featuredProjects.map(post => (
              <ProjectCard {...post} />
            ))}
          </ul>
          <LinkButton
            href={getRelativeLocaleUrl(locale, CATEGORIES.project.path)}
          >
            全部项目
            <IconArrowRight class="inline-block rtl:-rotate-180" />
          </LinkButton>
        </section>
      )
    }

    {
      sections.map(
        ({ key, posts }) =>
          posts.length > 0 && (
            <section class="border-border border-b pt-12 pb-6">
              <h2 class="text-2xl font-semibold tracking-wide">
                {CATEGORIES[key].title}
              </h2>
              <ul>
                {posts.map(post => (
                  <Card variant="h3" {...post} />
                ))}
              </ul>
              <LinkButton
                href={getRelativeLocaleUrl(locale, CATEGORIES[key].path)}
              >
                更多{CATEGORIES[key].label}
                <IconArrowRight class="inline-block rtl:-rotate-180" />
              </LinkButton>
            </section>
          )
      )
    }

    <div class="my-8 text-center">
      <LinkButton href={getRelativeLocaleUrl(locale, "posts")}>
        {t.home.allPosts}
        <IconArrowRight class="inline-block rtl:-rotate-180" />
      </LinkButton>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
