---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import { CATEGORIES, filterByCategory } from "@/utils/categories";
import config from "@/config";

const meta = CATEGORIES.leetcode;
const posts = getSortedPosts(
  filterByCategory(await getCollection("posts"), "leetcode")
);

// 汇总所有文章里的题目，用于顶部进度统计（按题号去重）
const problemMap = new Map<number, { difficulty: "简单" | "中等" | "困难" }>();
for (const post of posts) {
  for (const p of post.data.problems ?? []) {
    problemMap.set(p.id, { difficulty: p.difficulty });
  }
}
const all = [...problemMap.values()];
const stats = [
  { label: "已整理题目", value: all.length },
  { label: "简单", value: all.filter(p => p.difficulty === "简单").length },
  { label: "中等", value: all.filter(p => p.difficulty === "中等").length },
  { label: "困难", value: all.filter(p => p.difficulty === "困难").length },
  { label: "专题文章", value: posts.length },
];
---

<Layout title={`${meta.title} | ${config.site.title}`} description={meta.desc}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={meta.title} pageDesc={meta.desc}>
    <section aria-label="刷题进度">
      <dl class="grid grid-cols-2 gap-3 sm:grid-cols-5">
        {
          stats.map(s => (
            <div class="border-border rounded-lg border p-3 text-center">
              <dt class="text-sm opacity-75">{s.label}</dt>
              <dd class="text-accent text-2xl font-semibold">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      posts.length > 0 ? (
        <ul>
          {posts.map(post => (
            <Card {...post} />
          ))}
        </ul>
      ) : (
        <p class="mt-6">还没有刷题文章。</p>
      )
    }
  </Main>
  <Footer />
</Layout>
